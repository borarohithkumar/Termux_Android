('C106', 'Peter', 31, 'Yonkers', 'peter@gmail.com', 'M'),\
('C107', 'Rose', 26, 'Ithaca', 'rose@gmail.com', 'F'),\
('C108', 'Elina', 29, 'Auburn', 'elina@gmail.com', 'F');\
\
INSERT INTO Product VALUES\
('P101', 'High Boots', 'Diesel', 'Shoes', 'Blue', 'Good'),\
('P102', 'Mens Formal Shirt', 'Terrain', 'Clothing', 'Turquoise', 'Bad'),\
('P103', 'Pearl Earring', 'Essence', 'Accessories', 'Yellow', 'Excellent'),\
('P104', 'Kids Crocks', 'Sparx', NULL, 'Pink', 'Excellent'),\
('P105', 'Kids Shirt', 'Cosmos', 'Clothing', 'White', 'Bad'),\
('P106', 'Sporty Sneakers', 'Reebok', 'Shoes', 'White', 'Good'),\
('P107', 'Womens Jacket', 'NorthFace', 'Clothing', NULL, 'Good'),\
('P108', 'Leather Wallet', 'Luxurio', 'Accessories', 'Brown', 'Excellent');\
\
INSERT INTO Vendor VALUES\
('V101', 'Wendy Creations', '8976567890', 4),\
('V102', 'CrazyNuts', NULL, 3),\
('V103', 'FlyingHigh Retailers', '8126567890', 5),\
('V104', 'Global Traders', '8005432556', 2),\
('V105', 'Caretech Enterprises', '8116567890', 4),\
('V106', 'Infinity Solutions', '8056781234', 3),\
('V107', 'BrightWorks Technology', '8045678902', 5),\
('V108', 'Walgreens Retailers', '8034567891', 4);\
\
INSERT INTO VendorOffering VALUES\
('V101', 'P101', 6001.00),\
('V102', 'P102', 1200.33),\
('V102', 'P104', 1000.86),\
('V103', 'P101', 9333.67),\
('V103', 'P103', 200.00),\
('V104', 'P104', 900.00),\
('V104', 'P105', 334.00),\
('V105', 'P105', 222.50),\
('V107', 'P107', 334.00),\
('V108', 'P106', 5600.00);\
\
INSERT INTO Invoice VALUES\
('IN101', 'C101', 'V101', 'P101', 1, 12.5, '2023-08-11'),\
('IN102', 'C102', 'V102', 'P102', 3, 13.0, '2023-09-23'),\
('IN103', 'C103', 'V103', 'P103', 2, 15.2, '2023-06-10'),\
('IN104', 'C104', 'V104', 'P104', 1, 10.0, '2023-09-01'),\
('IN105', 'C103', 'V105', 'P105', 4, 5.0,  '2023-09-08'),\
('IN106', 'C106', 'V102', 'P104', 7, 10.8, '2023-10-02'),\
('IN107', 'C108', 'V103', 'P101', 4, 2.0,  '2023-10-12'),\
('IN108', 'C107', 'V104', 'P105', 3, 3.3,  '2023-06-12'),\
('IN109', 'C108', 'V108', 'P106', 8, 7.0,  '2023-07-18'),\
('IN110', 'C101', 'V103', 'P101', 10, 20.4, '2023-08-18');\
\
-- --------------------------------------------------------\
-- QUERIES\
-- --------------------------------------------------------\
\
-- 1. All invoices calculated with MRP & Final Price\
SELECT \
    i.CustId AS CUSTID, \
    i.InvoiceId AS INVOICEID, \
    CAST(ROUND(v.Price * i.QuantityPurchased) AS INT) AS MRP, \
    CAST(ROUND((v.Price * (1 - i.Discount / 100.0)) * i.QuantityPurchased) AS INT) AS FINAL_PRICE\
FROM Invoice i \
JOIN VendorOffering v \
    ON i.VendorId = v.VendorId \
    AND i.ProductId = v.ProductId;\
\
-- 2. Invoices filtered for bulk quantity purchased (> 2)\
SELECT \
    i.CustId AS CUSTID, \
    i.InvoiceId AS INVOICEID, \
    CAST(ROUND(v.Price * i.QuantityPurchased) AS INT) AS MRP, \
    CAST(ROUND((v.Price * (1 - i.Discount / 100.0)) * i.QuantityPurchased) AS INT) AS FINAL_PRICE\
FROM Invoice i \
JOIN VendorOffering v \
    ON i.VendorId = v.VendorId \
    AND i.ProductId = v.ProductId \
    AND i.QuantityPurchased > 2;\
\
-- 3. Individual customer item purchases ordered by location and brand\
SELECT c.CustLocation, c.CustId, p.Brand, i.QuantityPurchased\
FROM Customer c\
JOIN Invoice i ON c.CustId = i.CustId\
JOIN Product p ON i.ProductId = p.ProductId\
ORDER BY c.CustLocation ASC, p.Brand ASC;\
\
-- 4. Aggregated total products sold grouped by location and brand\
SELECT c.CustLocation, p.Brand, SUM(i.QuantityPurchased) AS productssold\
FROM Customer c                                       \
JOIN Invoice i ON c.CustId = i.CustId                                \
JOIN Product p ON i.ProductId = p.ProductId                          \
GROUP BY c.CustLocation, p.Brand                    \
ORDER BY c.CustLocation ASC, p.Brand ASC;\
\
-- 5. Fallback 'NA' for invoice ID on non-clothing items\
SELECT DISTINCT \
    p.ProductId, \
    p.PCategory,\
    CASE \
        WHEN p.PCategory = 'Clothing' AND i.InvoiceId IS NOT NULL THEN i.InvoiceId\
        ELSE 'NA'\
    END AS invoice_id\
FROM Product p\
LEFT JOIN Invoice i ON p.ProductId = i.ProductId\
WHERE p.PCategory IS NOT NULL;\
EOF
: 1791131172:0;cat << 'EOF' > sql2.sql\
-- ========================================================\
-- DATABASE: sql2.db\
-- TABLES: Publisher, Journal, Customer, Subscription\
-- ========================================================\
\
DROP TABLE IF EXISTS Subscription;\
DROP TABLE IF EXISTS Journal;\
DROP TABLE IF EXISTS Customer;\
DROP TABLE IF EXISTS Publisher;\
\
CREATE TABLE Publisher (\
    PUBLISHERID VARCHAR(10) PRIMARY KEY,\
    PUBLISHERNAME VARCHAR(100) NOT NULL,\
    RATING INT,\
    CONTACTNO VARCHAR(15)\
);\
\
CREATE TABLE Journal (\
    JOURNALID VARCHAR(10) PRIMARY KEY,\
    JOURNALNAME VARCHAR(100) NOT NULL,\
    GENRE VARCHAR(50),\
    MONTHLYCHARGES INT,\
    PUBLISHERID VARCHAR(10),\
    FOREIGN KEY (PUBLISHERID) REFERENCES Publisher(PUBLISHERID)\
);\
\
CREATE TABLE Customer (\
    CUSTOMERID VARCHAR(10) PRIMARY KEY,\
    CUSTOMERNAME VARCHAR(50) NOT NULL,\
    CUSTOMERTYPE VARCHAR(50),\
    STATE VARCHAR(50),\
    CITY VARCHAR(50)\
);\
\
CREATE TABLE Subscription (\
    SUBSCRIPTIONID VARCHAR(10) PRIMARY KEY,\
    JOURNALID VARCHAR(10),\
    CUSTOMERID VARCHAR(10),\
    STARTDATE DATE,\
    DURATIONINMONTHS INT,\
    DISCOUNTPERCENT DECIMAL(5, 2) DEFAULT 0.0,\
    FOREIGN KEY (JOURNALID) REFERENCES Journal(JOURNALID),\
    FOREIGN KEY (CUSTOMERID) REFERENCES Customer(CUSTOMERID)\
);\
\
INSERT INTO Publisher VALUES\
('P101', 'Taylor & Francis', 4, '8765678932'),\
('P102', 'Wiley', 2, NULL),\
('P103', 'Sage Publications', 2, '7885678932'),\
('P104', 'World Scientific', 3, '9765678932'),\
('P105', 'Routledge', 5, NULL),\
('P106', 'Springer Nature', 4, '7685655932');\
\
INSERT INTO Journal VALUES\
('J201', 'The Hollywood Reporter', 'Trade', 130, 'P105'),\
('J202', 'Kirkus Reviews', 'Trade', 90, 'P102'),\
('J203', 'The Lancet', 'Scientific', 75, 'P106'),\
('J204', 'eLife', 'Academics', 85, 'P102'),\
('J205', 'Pulp and Paper', 'Trade', 125, 'P102'),\
('J206', 'Acta Politica', 'Politics', 110, 'P105'),\
('J207', 'Global Policy', 'Politics', 105, 'P103'),\
('J208', 'LOS Biology', 'Academics', 95, 'P101');\
\
INSERT INTO Customer VALUES\
('C101', 'Sam', 'Regular', 'New York', 'Manhattan'),\
('C102', 'Jimmy', 'Privileged', 'Illinois', 'Chicago'),\
('C103', 'Michael', 'Prime', 'Texas', 'Dallas'),\
('C104', 'Oliver', 'Regular', 'Illinois', 'Chicago'),\
('C105', 'Clara', 'Regular', 'Arizona', 'Phoenix'),\
('C106', 'Amelia', 'Privileged', 'Arizona', 'Cottonwood'),\
('C107', 'Robert', 'Regular', 'Illinois', 'Galesburg');\
\
INSERT INTO Subscription VALUES\
('S301', 'J202', 'C107', '2023-11-22', 8, 5.0),\
('S302', 'J205', 'C105', '2023-09-10', 6, 0.0),\
('S303', 'J201', 'C102', '2023-10-15', 4, 10.0),\
('S304', 'J207', 'C103', '2023-02-25', 12, 15.0),\
('S305', 'J203', 'C101', '2023-11-22', 12, 0.0),\
('S306', 'J206', 'C105', '2023-11-22', 10, 8.0),\
('S307', 'J202', 'C106', '2023-01-12', 6, 0.0),\
('S308', 'J204', 'C107', '2023-06-29', 8, 12.0),\
('S309', 'J205', 'C103', '2023-01-12', 5, 0.0),\
('S310', 'J207', 'C102', '2023-08-17', 2, 5.0);\
\
-- --------------------------------------------------------\
-- QUERIES\
-- --------------------------------------------------------\
\
-- 1. Total revenue per publisher accounting for discount percentage\
SELECT \
    p.PUBLISHERNAME, \
    SUM(((j.MONTHLYCHARGES * s.DURATIONINMONTHS) * (1 - (s.DISCOUNTPERCENT / 100.0)))) AS totalrevenue\
FROM Publisher p\
JOIN Journal j ON p.PUBLISHERID = j.PUBLISHERID\
JOIN Subscription s ON j.JOURNALID = s.JOURNALID\
GROUP BY p.PUBLISHERNAME\
ORDER BY totalrevenue DESC;\
\
-- 2. Count of unique subscribers per publisher\
SELECT \
    p.PUBLISHERID, \
    j.JOURNALID, \
    s.CUSTOMERID, \
    COUNT(DISTINCT s.CUSTOMERID) AS count\
FROM Publisher p\
JOIN Journal j ON p.PUBLISHERID = j.PUBLISHERID\
JOIN Subscription s ON j.JOURNALID = s.JOURNALID\
GROUP BY p.PUBLISHERID;\
\
-- 3. Publishers having strictly more than 2 unique subscribers\
SELECT \
    p.PUBLISHERNAME, \
    COUNT(DISTINCT s.CUSTOMERID) AS NoOfUniqueSubscribers\
FROM Publisher p\
JOIN Journal j ON p.PUBLISHERID = j.PUBLISHERID\
JOIN Subscription s ON j.JOURNALID = s.JOURNALID\
GROUP BY p.PUBLISHERID\
HAVING NoOfUniqueSubscribers > 2;\
EOF
: 1791131176:0;cat << 'EOF' > sql3.sql\
-- ========================================================\
-- DATABASE: sql3.db\
-- TABLES: Sport, Event\
-- ========================================================\
\
DROP TABLE IF EXISTS Event;\
DROP TABLE IF EXISTS Sport;\
\
CREATE TABLE Sport (\
    sportid VARCHAR(10) PRIMARY KEY,\
    sportname VARCHAR(50) NOT NULL,\
    sporttype VARCHAR(20) NOT NULL,\
    venue VARCHAR(100) NOT NULL\
);\
\
CREATE TABLE Event (\
    eventid VARCHAR(10) PRIMARY KEY,\
    sportid VARCHAR(10),\
    playerid VARCHAR(10),\
    eventdate DATE,\
    noofattempts INT,\
    FOREIGN KEY (sportid) REFERENCES Sport(sportid)\
);\
\
INSERT INTO Sport VALUES\
('S001', '100m Backstroke', 'Swimming', 'University Sports Complex'),\
('S002', 'Freestyle Wrestling', 'Wrestling', 'Indoor Arena'),\
('S003', 'Shot Put Throw', 'Athletics', 'Outdoor Stadium'),\
('S004', 'Trail Running', 'Athletics', 'Lake Side Trail'),\
('S005', 'Greco Roman', 'Wrestling', 'Indoor Arena'),\
('S006', '200m Hurdles', 'Athletics', 'Athletic Track'),\
('S007', 'Javelin Throw', 'Athletics', 'Outdoor Stadium');\
\
INSERT INTO Event VALUES\
('E901', 'S002', 'P214', '2022-07-20', 1),\
('E902', 'S003', 'P213', '2022-07-22', 5),\
('E903', 'S001', 'P216', '2022-07-17', 2),\
('E904', 'S005', 'P215', '2022-07-15', 1),\
('E905', 'S007', 'P211', '2022-07-15', 6),\
('E906', 'S002', 'P214', '2022-07-21', 1),\
('E907', 'S007', 'P218', '2022-07-22', 6),\
('E908', 'S001', 'P214', '2022-07-17', 2),\
('E909', 'S001', 'P218', '2022-07-19', 1);\
\
-- --------------------------------------------------------\
-- QUERIES\
-- --------------------------------------------------------\
\
-- 1. Earliest event date where number of attempts was under 3\
SELECT eventid, eventdate \
FROM Event\
WHERE eventdate = (\
    SELECT MIN(eventdate) \
    FROM Event \
    WHERE noofattempts < 3\
);\
\
-- 2. List all sports with individual attempt records\
SELECT s.sportid, e.noofattempts AS max\
FROM Sport s\
LEFT JOIN Event e ON s.sportid = e.sportid;\
\
-- 3. Maximum attempts for Athletics sport and placeholder (0) for unplayed Athletics sport\
SELECT s.sportid, MAX(e.noofattempts) AS max\
FROM Sport s\
LEFT JOIN Event e ON s.sportid = e.sportid\
WHERE s.sporttype = 'Athletics'\
GROUP BY s.sportid\
HAVING max IS NOT NULL\
UNION\
SELECT MIN(s.sportid) AS sportid, COALESCE(e.noofattempts, 0) AS max\
FROM Sport s\
LEFT JOIN Event e ON s.sportid = e.sportid\
WHERE e.noofattempts IS NULL AND s.sporttype = 'Athletics';\
EOF
: 1791131180:0;cat << 'EOF' > sql4.sql\
-- ========================================================\
-- DATABASE: sql4.db\
-- TABLES: Customer, Flight, Booking\
-- ========================================================\
\
DROP TABLE IF EXISTS Booking;\
DROP TABLE IF EXISTS Flight;\
DROP TABLE IF EXISTS Customer;\
\
CREATE TABLE Customer (\
    CustId VARCHAR(10) PRIMARY KEY,\
    CustName VARCHAR(50) NOT NULL\
);\
\
CREATE TABLE Flight (\
    FlightId VARCHAR(10) PRIMARY KEY,\
    FlightName VARCHAR(50) NOT NULL,\
    FlightType VARCHAR(20),\
    Source VARCHAR(50),\
    Destination VARCHAR(50)\
);\
\
CREATE TABLE Booking (\
    BookingId INT PRIMARY KEY,\
    FlightId VARCHAR(10),\
    CustId VARCHAR(10),\
    TravelClass VARCHAR(20),\
    FlightCharge INT,\
    BookingDate DATE,\
    FOREIGN KEY (CustId) REFERENCES Customer(CustId),\
    FOREIGN KEY (FlightId) REFERENCES Flight(FlightId)\
);\
\
INSERT INTO Customer VALUES\
('C301', 'John'),\
('C302', 'Sam'),\
('C303', 'Robert'),\
('C304', 'Albert'),\
('C305', 'Jack');\
\
INSERT INTO Flight VALUES\
('F101', 'Spice Jet Airlines', 'Domestic', 'Mumbai', 'Kolkata'),\
('F102', 'Indian Airlines', 'International', 'Delhi', 'Germany'),\
('F103', 'Deccan Airlines', 'Domestic', 'Chennai', 'Bengaluru'),\
('F104', 'British Airways', 'International', 'London', 'Italy'),\
('F105', 'Swiss Airlines', 'International', 'Zurich', 'Spain');\
\
INSERT INTO Booking VALUES\
(201, 'F101', 'C301', 'Business', 12000, '2018-03-22'),\
(202, 'F105', 'C303', 'Business', 30000, '2018-05-17'),\
(203, 'F103', 'C302', 'Economy',  3000,  '2018-06-23'),\
(204, 'F101', 'C302', 'Economy',  10000, '2018-10-12'),\
(205, 'F104', 'C303', 'Business', 25000, '2019-01-16'),\
(206, 'F105', 'C301', 'Business', 30000, '2019-01-22'),\
(207, 'F104', 'C304', 'Economy',  22000, '2019-02-16'),\
(208, 'F101', 'C304', 'Business', 12000, '2019-09-18'),\
(209, 'F101', 'C305', 'Business', 8000,  '2019-09-18');\
\
-- --------------------------------------------------------\
-- QUERIES\
-- --------------------------------------------------------\
\
-- 1. Bookings exceeding the maximum Economy class charge\
SELECT bookingid, flightid, flightcharge\
FROM Booking\
WHERE flightcharge > (\
    SELECT MAX(flightcharge) \
    FROM Booking \
    WHERE travelclass = 'Economy'\
);\
\
-- 2. Customer business booking date with 'no bookin' fallback\
SELECT \
    c.custid, \
    c.custname, \
    COALESCE(b.bookingdate, 'no bookin') AS bdate\
FROM Customer c\
LEFT JOIN Booking b \
    ON c.custid = b.custid \
    AND b.travelclass = 'Business';\
\
-- 3. Customer with the highest total number of bookings\
SELECT b.CustId, c.CustName\
FROM Customer c \
JOIN Booking b ON c.CustId = b.CustId \
GROUP BY b.CustId\
HAVING COUNT(*) = (\
    SELECT MAX(count)\
    FROM (\
        SELECT COUNT(*) AS count \
        FROM Booking \
        GROUP BY CustId\
    )\
);\
\
-- 4. Minimum flight charge recorded per flight\
SELECT flightid, MIN(flightcharge) AS FlightCharge, bookingdate\
FROM Booking\
GROUP BY flightid;\
EOF
