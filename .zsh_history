: 1789087866:0;# 1. Print lines 25 to 45 of update.lua to see the default dir and bin_sufix logic
: 1789087866:0;sed -n '25,45p' ~/.local/share/nvim/lazy/codeium.nvim/lua/codeium/update.lua
: 1789087867:0;# 2. Check device architecture
: 1789087867:0;uname -m
: 1789087927:0;pkg install -y glibc-repo && pkg install -y glibc curl gzip
: 1789087930:0;# 2. Download the arm binary directly to a clean folder
: 1789087931:0;mkdir -p "$HOME/codeium_bin"
: 1789087931:0;curl -fLo "$HOME/codeium_bin/language_server_linux_arm.gz" \\
  "https://github.com/Exafunction/codeium/releases/download/language-server-v1.20.9/language_server_linux_arm.gz"
: 1789087936:0;gzip -d -f "$HOME/codeium_bin/language_server_linux_arm.gz"
: 1789087937:0;chmod +x "$HOME/codeium_bin/language_server_linux_arm"
: 1789087937:0;# 3. Test direct execution
: 1789087938:0;"$HOME/codeium_bin/language_server_linux_arm" --help 2>&1 | head -n 5
