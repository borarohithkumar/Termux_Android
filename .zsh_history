: 1788525284:0;cat << 'EOF' > auth_copilot.js\
const https = require("https");\
const fs = require("fs");\
const path = require("path");\
\
function post(hostname, endpoint, data) {\
  return new Promise((resolve, reject) => {\
    const payload = JSON.stringify(data);\
    const options = {\
      hostname: hostname,\
      path: endpoint,\
      method: "POST",\
      headers: {\
        "Content-Type": "application/json",\
        "Accept": "application/json",\
        "User-Agent": "GitHubCopilotChat/0.8.0",\
        "Content-Length": Buffer.byteLength(payload)\
      }\
    };\
\
    const req = https.request(options, (res) => {\
      let body = "";\
      res.on("data", (chunk) => body += chunk);\
      res.on("end", () => {\
        try {\
          resolve(JSON.parse(body));\
        } catch (e) {\
          reject(new Error("Response parse error: " + body));\
        }\
      });\
    });\
\
    req.on("error", reject);\
    req.write(payload);\
    req.end();\
  });\
}\
\
(async () => {\
  try {\
    const clientId = "01ab8ac9400c4e429b23"; // Official GitHub Copilot plugin client ID\
    const codeData = await post("github.com", "/login/device/code", {\
      client_id: clientId,\
      scope: "read:user"\
    });\
\
    if (!codeData.user_code) {\
      console.error("Failed to fetch code:", codeData);\
      process.exit(1);\
    }\
\
    console.log("\n==========================================");\
    console.log("1. Open in browser: " + (codeData.verification_uri || "https://github.com/login/device"));\
    console.log("2. Enter this CODE: " + codeData.user_code);\
    console.log("==========================================\n");\
    console.log("Waiting for browser approval...");\
\
    const interval = (codeData.interval || 5) * 1000;\
    const poll = async () => {\
      const res = await post("github.com", "/login/oauth/access_token", {\
        client_id: clientId,\
        device_code: codeData.device_code,\
        grant_type: "urn:ietf:params:oauth:grant-type:device_code"\
      });\
\
      if (res.access_token) {\
        const copilotDir = path.join(process.env.HOME, ".config", "github-copilot");\
        fs.mkdirSync(copilotDir, { recursive: true });\
\
        const payload = {\
          "github.com": {\
            user: "authorized",\
            oauth_token: res.access_token\
          }\
        };\
\
        fs.writeFileSync(path.join(copilotDir, "hosts.json"), JSON.stringify(payload, null, 2));\
        console.log("\nSuccess! Token written to ~/.config/github-copilot/hosts.json");\
        fs.unlinkSync(__filename);\
        process.exit(0);\
      } else if (res.error === "authorization_pending") {\
        setTimeout(poll, interval);\
      } else {\
        console.error("\nAuth failed:", res.error_description || res.error);\
        fs.unlinkSync(__filename);\
        process.exit(1);\
      }\
    };\
\
    setTimeout(poll, interval);\
  } catch (err) {\
    console.error("Error:", err.message);\
    process.exit(1);\
  }\
})();\
EOF
