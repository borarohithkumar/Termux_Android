: 1788528400:0;node -e '\
const fs = require("fs");\
const target = process.env.HOME + "/.local/share/nvim/lazy/copilot.lua/copilot/js/language-server.js";\
let code = fs.readFileSync(target, "utf8");\
\
const interceptor = `\
const Module = require("module");\
const origLoad = Module._load;\
Module._load = function(request, parent, isMain) {\
  if (typeof request === "string" && request.includes("watcher.node")) {\
    return {\
      watchDirectory: () => ({ dispose: () => {} }),\
      watchFile: () => ({ dispose: () => {} })\
    };\
  }\
  return origLoad.apply(this, arguments);\
};\
`;\
\
// Strip leading shebang if present, then add interceptor right after it\
if (code.startsWith("#!")) {\
  const firstNewline = code.indexOf("\n");\
  const shebang = code.slice(0, firstNewline + 1);\
  const rest = code.slice(firstNewline + 1);\
  fs.writeFileSync(target, shebang + interceptor + "\n" + rest, "utf8");\
} else {\
  fs.writeFileSync(target, interceptor + "\n" + code, "utf8");\
}\
console.log("SUCCESS: Patched language-server.js correctly!");\
'
