: 1789090545:0;# 1. Query the direct download URL for linux-aarch64
: 1789090545:0;AGENT_URL=$(curl -s "https://supermaven.com/api/download-path-v2?platform=linux&arch=aarch64&editor=neovim" | grep -o '"downloadUrl":"[^"]*' | cut -d'"' -f4)
: 1789090547:0;# 2. Target directory expected by binary_fetcher.lua
: 1789090547:0;DEST_DIR="$HOME/.supermaven/binary/v20/linux-aarch64"
: 1789090548:0;mkdir -p "$DEST_DIR"
: 1789090549:0;# 3. Download the actual binary
: 1789090549:0;echo "Downloading sm-agent from $AGENT_URL..."
: 1789090550:0;curl -fLo "$DEST_DIR/sm-agent.real" "$AGENT_URL"
: 1789090563:0;chmod +x "$DEST_DIR/sm-agent.real"
: 1789090564:0;# 4. Create the grun wrapper script that Neovim calls directly
