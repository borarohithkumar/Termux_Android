: 1789088005:0;grep -q "XDG_RUNTIME_DIR" ~/.zshrc || echo 'export XDG_RUNTIME_DIR="$PREFIX/tmp"' >> ~/.zshrc
: 1789088005:0;export XDG_RUNTIME_DIR="$PREFIX/tmp"
: 1789088006:0;mkdir -p "$PREFIX/tmp"
: 1789088152:0;nvim 
