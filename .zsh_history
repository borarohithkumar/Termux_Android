: 1791125134:0;cat << 'EOF' > infoscions.sql\
-- ============================================================\
-- Database: INFOSCIONS\
-- Description: Student performance tracking and score analysis\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE INFOSCIONS (\
    ID INTEGER PRIMARY KEY,\
    NAME TEXT,\
    MARKS INTEGER,\
    CLNO TEXT\
);\
\
-- Seed Data\
INSERT INTO INFOSCIONS (ID, NAME, MARKS, CLNO) VALUES \
(1, 'Amit', 85, '10A'),\
(2, 'Rahul', 60, '10A'),\
(3, 'Sita', 75, '10A'),\
(4, 'John', 90, '10B'),\
(5, 'Jane', 55, '10B');\
\
-- Queries\
-- 1. Select students scoring at or above the class average\
SELECT id, name, marks, clno\
FROM infoscions\
WHERE marks >= (SELECT AVG(marks) FROM infoscions);\
\
-- 2. Find records with marks strictly less than the maximum score (second highest candidates)\
SELECT id, name, marks, clno\
FROM infoscions\
WHERE marks < (SELECT MAX(marks) FROM infoscions);\
\
-- 3. Retrieve second highest and second lowest marks\
SELECT MAX(marks) AS second_highest\
FROM infoscions \
WHERE marks < (SELECT MAX(marks) FROM infoscions);\
\
SELECT MIN(marks) AS second_lowest\
FROM infoscions \
WHERE marks > (SELECT MIN(marks) FROM infoscions);\
EOF
: 1791125137:0;cat << 'EOF' > customer_invoice_simple.sql\
-- ============================================================\
-- Database: Customer & Invoice (Basic)\
-- Description: Simple invoice discount analysis per customer location\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE customer (\
    custid VARCHAR(10) PRIMARY KEY,\
    custname VARCHAR(50),\
    custlocation VARCHAR(50)\
);\
\
CREATE TABLE invoice (\
    invoiceno VARCHAR(10) PRIMARY KEY,\
    custid VARCHAR(10),\
    discount INT,\
    FOREIGN KEY (custid) REFERENCES customer(custid)\
);\
\
-- Seed Data\
INSERT INTO customer VALUES \
('C101', 'Alice', 'Yonkers'),\
('C102', 'Bob', 'Yonkers'),\
('C103', 'Charlie', 'New York');\
\
INSERT INTO invoice VALUES \
('IN110', 'C101', 10),\
('IN111', 'C101', 5),\
('IN112', 'C102', 15),\
('IN113', 'C103', 25);\
\
-- Queries\
-- 1. Find maximum discount for customers located in 'Yonkers' using LEFT JOIN\
SELECT c.custid, c.custname, MAX(i.discount) AS highdisc\
FROM customer c\
LEFT JOIN invoice i ON c.custid = i.custid\
WHERE c.custlocation = 'Yonkers'\
GROUP BY c.custid, c.custname;\
\
-- 2. Correlated subquery version with subquery filter\
SELECT \
    c.custid, \
    c.custname, \
    (SELECT MAX(i.discount) FROM invoice i WHERE i.custid = c.custid) AS highdisc\
FROM customer c\
WHERE c.custid IN (\
    SELECT custid \
    FROM customer \
    WHERE custlocation = 'Yonkers'\
)\
GROUP BY c.custid, c.custname;\
EOF
: 1791125140:0;cat << 'EOF' > product_catalog.sql\
-- ============================================================\
-- Database: Product Catalog\
-- Description: Self-join and cross-product category comparisons\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE Product (\
    ProductId VARCHAR(10) PRIMARY KEY,\
    PName VARCHAR(50),\
    Brand VARCHAR(50),\
    PCategory VARCHAR(50),\
    Color VARCHAR(30),\
    Review VARCHAR(30)\
);\
\
-- Seed Data\
INSERT INTO Product (ProductId, PName, Brand, PCategory, Color, Review) VALUES\
('P101', 'High Boots', 'Diesel', 'Shoes', 'Blue', 'Good'),\
('P102', 'Mens Formal Shirt', 'Terrain', 'Clothing', 'Turquoise', 'Bad'),\
('P103', 'Pearl Earring', 'Essence', 'Accessories', 'Yellow', 'Excellent'),\
('P104', 'Kids Crocks', 'Sparx', NULL, 'Pink', 'Excellent'),\
('P105', 'Kids Shirt', 'Cosmos', 'Clothing', 'White', 'Bad'),\
('P106', 'Sporty Sneakers', 'Reebok', 'Shoes', 'White', 'Good'),\
('P107', 'Womens Jacket', 'NorthFace', 'Clothing', NULL, 'Good'),\
('P108', 'Leather Wallet', 'Luxurio', 'Accessories', 'Brown', 'Excellent'),\
('P109', 'Leather Wallet', 'Reebok', 'Accessories', 'Brown', 'Excellent');\
\
-- Queries\
-- 1. Distinct products sharing the same category and review (excluding 'Bad' reviews)\
SELECT DISTINCT p1.productid, p1.pname, p1.pcategory, p1.review\
FROM Product p1\
JOIN Product p2\
  ON p1.pcategory = p2.pcategory\
 AND p1.review = p2.review\
 AND p1.productid <> p2.productid\
WHERE p1.review <> 'Bad';\
\
-- 2. Left join variant on category and review\
SELECT DISTINCT p1.productid, p1.pname, p1.pcategory, p1.review\
FROM Product p1\
LEFT JOIN Product p2\
  ON p1.pcategory = p2.pcategory\
 AND p1.review = p2.review\
 AND p1.productid <> p2.productid\
WHERE p1.review <> 'Bad';\
EOF
: 1791125143:0;cat << 'EOF' > retail_store.sql\
-- ============================================================\
-- Database: Full Retail Store\
-- Description: Customers, Vendors, Offerings, Invoices, and Pricing\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE Customer (\
    CustId VARCHAR(5) PRIMARY KEY CHECK (CustId LIKE 'C%'),\
    CustName VARCHAR(50) NOT NULL,\
    Age NUMERIC(2) CHECK (Age BETWEEN 0 AND 99),\
    CustLocation VARCHAR(20),\
    Email VARCHAR(30) UNIQUE,\
    Gender CHAR(1) CHECK (Gender IN ('M', 'F'))\
);\
\
CREATE TABLE Vendor (\
    VendorId VARCHAR(5) PRIMARY KEY,\
    VendorName VARCHAR(50),\
    VendorContactNo VARCHAR(15),\
    Rating NUMERIC(2)\
);\
\
CREATE TABLE Product (\
    ProductId VARCHAR(5) PRIMARY KEY,\
    PName VARCHAR(50),\
    Brand VARCHAR(50),\
    PCategory VARCHAR(50),\
    Color VARCHAR(20),\
    Review VARCHAR(20)\
);\
\
CREATE TABLE VendorOffering (\
    VendorId VARCHAR(5),\
    ProductId VARCHAR(5),\
    Price NUMERIC(7,2) NOT NULL CHECK (Price > 0),\
    PRIMARY KEY (VendorId, ProductId),\
    FOREIGN KEY (VendorId) REFERENCES Vendor(VendorId),\
    FOREIGN KEY (ProductId) REFERENCES Product(ProductId)\
);\
\
CREATE TABLE Invoice (\
    InvoiceId VARCHAR(5) PRIMARY KEY CHECK (InvoiceId LIKE 'IN%'),\
    CustId VARCHAR(5),\
    VendorId VARCHAR(5),\
    ProductId VARCHAR(5),\
    QuantityPurchased NUMERIC(2) NOT NULL,\
    Discount NUMERIC(3,1) NOT NULL DEFAULT 0.0,\
    PurchaseDate DATE NOT NULL DEFAULT CURRENT_DATE,\
    FOREIGN KEY (CustId) REFERENCES Customer(CustId),\
    FOREIGN KEY (VendorId) REFERENCES Vendor(VendorId),\
    FOREIGN KEY (ProductId) REFERENCES Product(ProductId)\
);\
\
-- Queries\
-- 1. Customer locations with more than 1 registered customer\
SELECT CustLocation, COUNT(*) AS countrows\
FROM Customer\
GROUP BY CustLocation\
HAVING COUNT(*) > 1;\
\
-- 2. Invoice mapping for clothing products with conditional fallback ('NA')\
SELECT DISTINCT p.productid, p.pcategory,\
    CASE \
        WHEN p.pcategory = 'Clothing' AND i.invoiceid IS NOT NULL THEN i.invoiceid\
        ELSE 'NA'\
    END AS invoice_id\
FROM Product p\
LEFT JOIN Invoice i ON p.ProductId = i.ProductId\
WHERE p.pcategory IS NOT NULL;\
\
-- 3. Calculate MRP and Final Price for high-volume orders (Quantity > 2)\
SELECT \
    i.custid AS CUSTID,\
    i.invoiceid AS INVOICEID,\
    CAST(ROUND(v.price * i.quantitypurchased) AS INT) AS MRP,\
    CAST(ROUND((v.price * (1 - i.discount / 100.0)) * i.quantitypurchased) AS INT) AS FINAL_PRICE\
FROM Invoice i\
JOIN VendorOffering v \
    ON i.vendorid = v.vendorid \
   AND i.productid = v.productid\
WHERE i.quantitypurchased > 2;\
\
-- 4. Total products sold broken down by Customer Location and Brand\
SELECT \
    c.custlocation, \
    p.brand, \
    SUM(i.quantitypurchased) AS productssold\
FROM Customer c                                       \
JOIN Invoice i ON c.custid = i.custid                                \
JOIN Product p ON i.productid = p.productid                          \
GROUP BY c.custlocation, p.brand                    \
ORDER BY c.custlocation ASC, p.brand ASC;\
EOF
: 1791125147:0;cat << 'EOF' > sports_events.sql\
-- ============================================================\
-- Database: Sports & Events\
-- Description: Tournament logs, athlete attempts, and sport venues\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE Sport (\
    sportid VARCHAR(10) PRIMARY KEY,\
    sportname VARCHAR(50) NOT NULL,\
    sporttype VARCHAR(20) NOT NULL,\
    venue VARCHAR(100) NOT NULL\
);\
\
CREATE TABLE Event (\
    eventid VARCHAR(10) PRIMARY KEY,\
    sportid VARCHAR(10),\
    playerid VARCHAR(10),\
    eventdate DATE,\
    noofattempts INT,\
    FOREIGN KEY (sportid) REFERENCES Sport(sportid)\
);\
\
-- Seed Data\
INSERT INTO Sport (sportid, sportname, sporttype, venue) VALUES\
('S001', '100m Backstroke', 'Swimming', 'University Sports Complex'),\
('S002', 'Freestyle Wrestling', 'Wrestling', 'Indoor Arena'),\
('S003', 'Shot Put Throw', 'Athletics', 'Outdoor Stadium'),\
('S004', 'Trail Running', 'Athletics', 'Lake Side Trail'),\
('S005', 'Greco Roman', 'Wrestling', 'Indoor Arena'),\
('S006', '200m Hurdles', 'Athletics', 'Athletic Track'),\
('S007', 'Javelin Throw', 'Athletics', 'Outdoor Stadium');\
\
INSERT INTO Event (eventid, sportid, playerid, eventdate, noofattempts) VALUES\
('E901', 'S002', 'P214', '2022-07-20', 1),\
('E902', 'S003', 'P213', '2022-07-22', 5),\
('E903', 'S001', 'P216', '2022-07-17', 2),\
('E904', 'S005', 'P215', '2022-07-15', 1),\
('E905', 'S007', 'P211', '2022-07-15', 6),\
('E906', 'S002', 'P214', '2022-07-21', 1),\
('E907', 'S007', 'P218', '2022-07-22', 6),\
('E908', 'S001', 'P214', '2022-07-17', 2),\
('E909', 'S001', 'P218', '2022-07-19', 1);\
\
-- Queries\
-- 1. Minimum event date where attempts were fewer than 3\
SELECT MIN(eventdate) \
FROM Event\
WHERE noofattempts < 3;\
\
-- 2. Athletics sports: Overall max attempts alongside first unplayed event (0 attempts)\
SELECT \
    s.sportid AS SPORTID, \
    MAX(e.noofattempts) AS MAXNOOFATTEMPTS\
FROM Sport s\
JOIN Event e ON s.sportid = e.sportid\
WHERE s.sporttype = 'Athletics'\
  AND e.noofattempts = (\
      SELECT MAX(e2.noofattempts) \
      FROM Event e2 \
      JOIN Sport s2 ON e2.sportid = s2.sportid \
      WHERE s2.sporttype = 'Athletics'\
  )\
GROUP BY s.sportid\
UNION\
SELECT \
    MIN(s.sportid) AS SPORTID, \
    0 AS MAXNOOFATTEMPTS\
FROM Sport s\
LEFT JOIN Event e ON s.sportid = e.sportid\
WHERE s.sporttype = 'Athletics' \
  AND e.sportid IS NULL;\
EOF
: 1791125150:0;cat << 'EOF' > flight_booking.sql\
-- ============================================================\
-- Database: Flight Booking System\
-- Description: Flight routes, customer bookings, and fare comparisons\
-- ============================================================\
\
-- Schema Definition\
CREATE TABLE Customer (\
    CustId VARCHAR(10) PRIMARY KEY,\
    CustName VARCHAR(50) NOT NULL\
);\
\
CREATE TABLE Flight (\
    FlightId VARCHAR(10) PRIMARY KEY,\
    FlightName VARCHAR(50) NOT NULL,\
    FlightType VARCHAR(20),\
    Source VARCHAR(50),\
    Destination VARCHAR(50)\
);\
\
CREATE TABLE Booking (\
    BookingId INT PRIMARY KEY,\
    FlightId VARCHAR(10),\
    CustId VARCHAR(10),\
    TravelClass VARCHAR(20),\
    FlightCharge INT,\
    BookingDate DATE,\
    FOREIGN KEY (CustId) REFERENCES Customer(CustId),\
    FOREIGN KEY (FlightId) REFERENCES Flight(FlightId)\
);\
\
-- Seed Data\
INSERT INTO Customer (CustId, CustName) VALUES\
('C301', 'John'),\
('C302', 'Sam'),\
('C303', 'Robert'),\
('C304', 'Albert'),\
('C305', 'Jack');\
\
INSERT INTO Flight (FlightId, FlightName, FlightType, Source, Destination) VALUES\
('F101', 'Spice Jet Airlines', 'Domestic', 'Mumbai', 'Kolkata'),\
('F102', 'Indian Airlines', 'International', 'Delhi', 'Germany'),\
('F103', 'Deccan Airlines', 'Domestic', 'Chennai', 'Bengaluru'),\
('F104', 'British Airways', 'International', 'London', 'Italy'),\
('F105', 'Swiss Airlines', 'International', 'Zurich', 'Spain');\
\
INSERT INTO Booking (BookingId, FlightId, CustId, TravelClass, FlightCharge, BookingDate) VALUES\
(201, 'F101', 'C301', 'Business', 12000, '2018-03-22'),\
(202, 'F105', 'C303', 'Business', 30000, '2018-05-17'),\
(203, 'F103', 'C302', 'Economy',  3000,  '2018-06-23'),\
(204, 'F101', 'C302', 'Economy',  10000, '2018-10-12'),\
(205, 'F104', 'C303', 'Business', 25000, '2019-01-16'),\
(206, 'F105', 'C301', 'Business', 30000, '2019-01-22'),\
(207, 'F104', 'C304', 'Economy',  22000, '2019-02-16'),\
(208, 'F101', 'C304', 'Business', 12000, '2019-09-18'),\
(209, 'F101', 'C305', 'Business', 8000,  '2019-09-18');\
\
-- Queries\
-- 1. Bookings with fare strictly greater than the maximum Economy flight charge\
SELECT bookingid, flightid, flightcharge\
FROM Booking\
WHERE flightcharge > (\
    SELECT MAX(flightcharge) \
    FROM Booking \
    WHERE travelclass = 'Economy'\
);\
\
-- 2. Customer business bookings with fallback date label\
SELECT c.custid, c.custname, COALESCE(b.bookingdate, 'no bookin') AS bdate\
FROM Customer c\
LEFT JOIN Booking b\
  ON c.custid = b.custid\
 AND b.travelclass = 'Business';\
\
-- 3. Customers with the maximum number of flight bookings\
SELECT b.custid, c.custname\
FROM Customer c\
JOIN Booking b ON c.custid = b.custid\
GROUP BY b.custid\
HAVING COUNT(*) = (\
    SELECT MAX(count) \
    FROM (SELECT COUNT(*) AS count FROM Booking GROUP BY custid)\
);\
\
-- 4. Minimum flight charge per flight route\
SELECT flightid, MIN(flightcharge) AS FlightCharge, bookingdate\
FROM Booking\
GROUP BY flightid;\
EOF
