: 1788528300:0;node -e '\
const fs = require("fs");\
const target = process.env.HOME + "/.local/share/nvim/lazy/copilot.lua/copilot/js/main.js";\
let code = fs.readFileSync(target, "utf8");\
\
// Replaces any require call resolving watcher.node with a mock object\
const patched = code.replace(/require\([^)]*watcher\.node[^)]*\)/g, "({watchDirectory:()=>{return{dispose:()=>{}}},watchFile:()=>{return{dispose:()=>{}}}})");\
\
if (code !== patched) {\
  fs.writeFileSync(target, patched, "utf8");\
  console.log("SUCCESS: Replaced watcher.node require call!");\
} else {\
  // If regex missed the exact argument format, patch require.extensions at the top of the file\
  const shim = "require.extensions[\x27.node\x27]=(m)=>{m.exports={watchDirectory:()=>({dispose:()=>{}}),watchFile:()=>({dispose:()=>{}})}};\n";\
  fs.writeFileSync(target, shim + code, "utf8");\
  console.log("SUCCESS: Added .node loader shim to top of main.js!");\
}\
'
: 1788528365:0;node -e '\
const fs = require("fs");\
const target = process.env.HOME + "/.local/share/nvim/lazy/copilot.lua/copilot/js/language-server.js";\
let code = fs.readFileSync(target, "utf8");\
\
const interceptor = `\
const Module = require("module");\
const origLoad = Module._load;\
Module._load = function(request, parent, isMain) {\
  if (typeof request === "string" && request.includes("watcher.node")) {\
    return {\
      watchDirectory: () => ({ dispose: () => {} }),\
      watchFile: () => ({ dispose: () => {} })\
    };\
  }\
  return origLoad.apply(this, arguments);\
};\
`;\
\
if (!code.includes("watcher.node")) {\
  fs.writeFileSync(target, interceptor + "\n" + code, "utf8");\
  console.log("Successfully injected watcher interceptor!");\
} else {\
  console.log("Interceptor already present.");\
}\
'
