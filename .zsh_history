: 1789088000:0;# 1. Create the glibc wrapper script
: 1789088001:0;cat << 'EOF' > "$HOME/codeium_bin/codeium-termux"\
#!/data/data/com.termux/files/usr/bin/bash\
exec grun "$HOME/codeium_bin/language_server_linux_arm" "$@"\
EOF
