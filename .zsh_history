: 1789091215:0;# Replace the broken block cleanly with an exact, non-duplicate table
: 1789091216:0;cat << 'EOF' > /data/data/com.termux/files/usr/tmp/patch_start.py\
import sys, re\
\
path = sys.argv[1]\
grun = sys.argv[2]\
real_bin = sys.argv[3]\
\
with open(path, 'r') as f:\
    content = f.read()\
\
pattern = r'self\.handle\s*=\s*loop\.spawn\([\s\S]*?stdio\s*=\s*\{\s*self\.stdin,\s*self\.stdout,\s*self\.stderr\s*\},'\
\
replacement = f'''self.handle = loop.spawn("{grun}", {{\
    args = {{\
      "{real_bin}",\
      "stdio",\
    }},\
    stdio = {{ self.stdin, self.stdout, self.stderr }},'''\
\
new_content = re.sub(pattern, replacement, content, count=1)\
with open(path, 'w') as f:\
    f.write(new_content)\
EOF
